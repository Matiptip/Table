            0% {
                opacity: 0;
                transform: translateY(20px);
            }
            100% {
                opacity: 1;
                transform: translateY(0);
            }
        }
        .builder-component-appear {
            animation: fadeInSlideUp 0.5s ease-out forwards;
        }
    </style>
