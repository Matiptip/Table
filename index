        // Add scanline effect to price cards on hover
        const priceCards = document.querySelectorAll('.glow-hover'); // This selector is still relevant for price cards
        priceCards.forEach(card => {
            card.addEventListener('mouseenter', function() {
                this.classList.add('scanline');
                const colors = ['neon-border-blue', 'neon-border-pink', 'neon-border-purple'];
                const randomColor = colors[Math.floor(Math.random() * colors.length)];
                
                this.classList.remove('neon-border-blue', 'neon-border-pink', 'neon-border-purple');
                this.classList.add(randomColor);

                const glowColors = {
                    'neon-border-blue': 'neon-blue-glow',
                    'neon-border-pink': 'neon-pink-glow',
                    'neon-border-purple': 'neon-purple-glow'
                };
                if (glowColors[randomColor]) {
                    this.classList.add('animate-pulse-glow-strong', glowColors[randomColor]);
                }
            });
            
            card.addEventListener('mouseleave', function() {
                this.classList.remove('scanline');
                this.classList.remove('animate-pulse-glow-strong', 'neon-blue-glow', 'neon-pink-glow', 'neon-purple-glow');
            });
        });

