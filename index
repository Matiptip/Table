    <script>
        // Terminal animation
        const terminalLines = [
            "> Welcome to NeonWeb Dev console",
            "> Current system status: ONLINE",
            "> Firewall: ACTIVE",
            "> Last intrusion attempt: 3.2 seconds ago",
            "> Ready to accept your commands...",
            "> Type 'help' for available options",
            "> Scanning for vulnerabilities...",
            "> All systems secure",
            "> Monitoring network traffic...",
            "> No anomalies detected"
        ];
        
        let currentLine = 0;
        const terminal = document.getElementById('terminal-content');
        
        function addTerminalLine() {
            if (currentLine < terminalLines.length) {
                terminal.innerHTML += terminalLines[currentLine] + '<br>';
                currentLine++;
                terminal.scrollTop = terminal.scrollHeight;
            } else {
                currentLine = 0;
                terminal.innerHTML = '> ' + terminalLines[currentLine] + '<br>';
                currentLine++;
            }
            
            setTimeout(addTerminalLine, 3000);
        }
        
        // Start the terminal animation
        setTimeout(addTerminalLine, 2000);
        
        // Button hover effects
        const buttons = document.querySelectorAll('button');
        buttons.forEach(button => {
            button.addEventListener('mouseenter', () => {
                const audio = new Audio('https://assets.mixkit.co/sfx/preview/mixkit-arcade-game-jump-coin-216.mp3');
                audio.volume = 0.2;
                audio.play();
            });
        });
        
        // Add scanline effect to price cards on hover
        const priceCards = document.querySelectorAll('.glow-hover');
        priceCards.forEach(card => {
            card.addEventListener('mouseenter', function() {
                this.classList.add('scanline');
                const colors = ['neon-border-blue', 'neon-border-pink', 'neon-border-purple'];
                const randomColor = colors[Math.floor(Math.random() * colors.length)];
                
                // Remove all glow classes first
