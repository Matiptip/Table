            "> Current system status: ONLINE",
            "> Firewall: ACTIVE",
            "> Last intrusion attempt: 3.2 seconds ago",
            "> Ready to accept your commands...",
            "> Type 'help' for available options",
            "> Scanning for vulnerabilities...",
            "> All systems secure",
            "> Monitoring network traffic...",
            "> No anomalies detected"
        ];
        
        let currentLine = 0;
        const terminal = document.getElementById('terminal-content');
        
        function addTerminalLine() {
            if (terminal && currentLine < terminalLines.length) { // Added check for terminal existence
                terminal.innerHTML += terminalLines[currentLine] + '<br>';
                currentLine++;
                terminal.scrollTop = terminal.scrollHeight;
            } else if (terminal) { // Added check for terminal existence
                currentLine = 0;
                terminal.innerHTML = '> ' + terminalLines[currentLine] + '<br>';
                currentLine++;
            }
            // If terminal doesn't exist, this function will simply not reschedule itself.
            if (terminal) setTimeout(addTerminalLine, 3000);
        }
        
        // Start the terminal animation if terminal element exists
        if (document.getElementById('terminal-content')) {
            setTimeout(addTerminalLine, 2000);
        }
        
        // Button hover effects
        // Adjusted to querySelectorAll for elements present on this page specifically.
        // The link to Builder.html and price card buttons are the main interactive elements left.
        const pageButtons = document.querySelectorAll('button, a.cyber-button-ref'); 
        pageButtons.forEach(button => {
