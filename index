        }
        
        .neon-text-blue {
            color: var(--neon-blue);
            text-shadow: 0 0 5px var(--neon-blue), 0 0 10px var(--neon-blue);
        }
        
        .neon-text-purple {
            color: var(--neon-purple);
            text-shadow: 0 0 5px var(--neon-purple), 0 0 10px var(--neon-purple);
        }
        
        .neon-border-pink {
            border: 2px solid var(--neon-pink);
            box-shadow: 0 0 10px var(--neon-pink), inset 0 0 10px var(--neon-pink);
        }
        
        .neon-border-blue {
            border: 2px solid var(--neon-blue);
            box-shadow: 0 0 10px var(--neon-blue), inset 0 0 10px var(--neon-blue);
        }
        
        .neon-border-purple {
            border: 2px solid var(--neon-purple);
            box-shadow: 0 0 10px var(--neon-purple), inset 0 0 10px var(--neon-purple);
        }
        
        .glow-hover:hover {
            transform: scale(1.02);
            transition: all 0.3s ease; /* Ensure smooth transition for glow-hover */
        }
        
        .scanline {
            position: relative;
            overflow: hidden;
        }
        
        .scanline::after {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(
                to bottom,
                transparent 0%,
                rgba(255, 255, 255, 0.05) 50%,
                transparent 100%
            );
            background-size: 100% 4px;
            animation: scanline 6s linear infinite;
            pointer-events: none;
        }
        
        @keyframes scanline {
            0% { background-position: 0 0; }
            100% { background-position: 0 100%; }
        }
        
        .terminal-cursor::after {
            content: "|";
            animation: blink 1s step-end infinite;
            color: var(--neon-blue);
        }
        
        @keyframes blink {
            from, to { opacity: 1; }
            50% { opacity: 0; }
        }
        
        /* grid-pattern is now grid-pattern-animated, definition changed below */

        /* --- Cyberpunk Animation Refinements --- */

        /* Text Glitch/Flicker Effect - Made more subtle */
        @keyframes text-glitch {
            5%, 45% { /* Less frequent */
                transform: translate(1px, 0) skew(0deg);
                opacity: 0.9;
            }
            10%, 40% {
                transform: translate(-1px, 0) skew(0deg);
            }
            15%, 35% { /* Shorter duration of effect */
                transform: translate(0, 0) skew(1deg);
            }
        }
        .animate-text-glitch {
            animation: text-glitch 2.5s linear infinite; /* Slowed down */
            display: inline-block;
        }

        @keyframes text-flicker-fast { /* Kept as is, but applied more sparingly */
          0%, 100% { opacity: 1; }
          50% { opacity: 0.3; }
        }
        .animate-text-flicker-fast {
            animation: text-flicker-fast 0.2s linear infinite alternate;
        }

        /* Enhanced Pulsing Glow - Smoother timing */
        @keyframes pulse-glow-strong {
            0%, 100% { box-shadow: 0 0 10px var(--neon-current-color), inset 0 0 8px var(--neon-current-color); }
            50% { box-shadow: 0 0 20px var(--neon-current-color), inset 0 0 15px var(--neon-current-color); }
        }
        .animate-pulse-glow-strong {
            --neon-current-color: var(--neon-pink); /* Default */
            animation: pulse-glow-strong 2s ease-in-out infinite alternate; /* Smoother and slightly slower */
        }
        .neon-blue-glow { --neon-current-color: var(--neon-blue); }
        .neon-pink-glow { --neon-current-color: var(--neon-pink); }
        .neon-purple-glow { --neon-current-color: var(--neon-purple); }
        .neon-green-glow { --neon-current-color: #39ff14; }
        .neon-yellow-glow { --neon-current-color: #f3ca20; }

        /* Animated Background Grid Line Animation */
        .grid-pattern-animated { /* Replaces old .grid-pattern */
            background-image:
                linear-gradient(rgba(5, 217, 232, 0.1) 1px, transparent 1px),
                linear-gradient(90deg, rgba(5, 217, 232, 0.1) 1px, transparent 1px);
            background-size: 20px 20px;
            animation: pulse-grid 10s linear infinite alternate;
        }
        @keyframes pulse-grid {
            0% { background-image: linear-gradient(rgba(5, 217, 232, 0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(5, 217, 232, 0.05) 1px, transparent 1px); }
            50% { background-image: linear-gradient(rgba(5, 217, 232, 0.15) 1px, transparent 1px), linear-gradient(90deg, rgba(5, 217, 232, 0.15) 1px, transparent 1px); }
            100% { background-image: linear-gradient(rgba(5, 217, 232, 0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(5, 217, 232, 0.05) 1px, transparent 1px); }
        }

        /* Scanline intensity on hover */
        .scanline-intensify:hover::after {
            animation: scanline-fast 0.5s linear infinite;
            background-size: 100% 6px; /* Thicker scanlines */
        }
        @keyframes scanline-fast {
            0% { background-position: 0 0; opacity: 0.5; }
            100% { background-position: 0 100%; opacity: 0.1; }
        }
        
        /* New Animation for Dropped Builder Components */
        @keyframes fadeInSlideUp {
            0% {
                opacity: 0;
                transform: translateY(20px);
            }
            100% {
                opacity: 1;
                transform: translateY(0);
            }
        }
        .builder-component-appear {
            animation: fadeInSlideUp 0.5s ease-out forwards;
        }

        /* Animations for Builder Placeholder Icons */
        @keyframes moveMouseToPointer {
            0%, 100% { transform: translateX(0) translateY(0) scale(1); }
            25% { transform: translateX(-5px) translateY(-5px) scale(1.1); } /* Move towards dots */
            50% { transform: translateX(10px) translateY(0) scale(1); } /* Move past dots towards component */
            75% { transform: translateX(5px) translateY(0) scale(1.1) rotate(-10deg); } /* 'Grab' component */
        }

        @keyframes moveComponentSlightly {
            0%, 100% { transform: translateX(0) translateY(0); }
            50% { transform: translateX(5px) translateY(-5px) scale(1.05); } /* Component lifts and moves */
            75% { transform: translateX(0px) translateY(0px) scale(1); } /* Component settles briefly */
        }

        .ph-mouse {
            animation: moveMouseToPointer 4s ease-in-out infinite;
            display: inline-block; /* Allow transform */
        }

        .ph-component-icon {
            animation: moveComponentSlightly 4s ease-in-out infinite;
            animation-delay: 0.5s; /* Stagger from mouse */
            display: inline-block; /* Allow transform */
        }

        .ph-dots {
            display: inline-block;
            opacity: 0.7;
        }
    </style>
